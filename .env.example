# --- Supabase (required) ---
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Guesty Open API (optional — app runs in mock mode while blank) ---
# Guesty dashboard → Integrations → API & Webhooks → Create a new API application.
# Requires Open API access on your plan tier (not included with Guesty Lite).
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=

# Shared secret you set when registering the webhook in Guesty.
GUESTY_WEBHOOK_SECRET=

# --- TV signage (optional) ---
# Comma-separated public URLs of screensaver media (mp4/webm/jpg/png/webp).
# Shown on standby TVs between stays, before repo and Supabase-bucket media.
SCREENSAVER_URLS=

# Public URL of the deployed portal; minted QR codes and TV pairing text use
# this. Falls back to the Vercel deployment URL, then localhost.
NEXT_PUBLIC_PORTAL_URL=

# Guesty listing custom-field IDs carrying per-property Wi-Fi
# (Guesty dashboard -> Settings -> Custom fields -> copy each field ID)
GUESTY_WIFI_SSID_FIELD_ID=
GUESTY_WIFI_PASSWORD_FIELD_ID=
